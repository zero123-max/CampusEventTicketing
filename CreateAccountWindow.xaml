<Window x:Class="CampusEventTicketing.CreateAccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create Account - Campus Event &amp; Ticketing System"
        Width="820" Height="840" MinWidth="740" MinHeight="700"
        WindowStartupLocation="CenterOwner"
        Background="White">

    <Window.Resources>
        <SolidColorBrush x:Key="CcNavy" Color="#0B2B5B"/>
        <SolidColorBrush x:Key="CcBlue" Color="#2D63E8"/>
        <SolidColorBrush x:Key="CcMuted" Color="#5B6F94"/>
        <SolidColorBrush x:Key="CcLine" Color="#C9D7EE"/>
        <SolidColorBrush x:Key="CcLink" Color="#1F5FE0"/>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource CcNavy}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="#8A9BBE"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="16,0,0,0"/>
        </Style>

        <Style x:Key="FieldText" TargetType="TextBox">
            <Setter Property="Height" Value="50"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Foreground" Value="{StaticResource CcNavy}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="White" BorderBrush="{StaticResource CcLine}"
                                BorderThickness="1.5" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource CcBlue}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldTextPwd" TargetType="TextBox" BasedOn="{StaticResource FieldText}">
            <Setter Property="Padding" Value="14,0,48,0"/>
        </Style>

        <Style x:Key="FieldPassword" TargetType="PasswordBox">
            <Setter Property="Height" Value="50"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="14,0,48,0"/>
            <Setter Property="Foreground" Value="{StaticResource CcNavy}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="bd" Background="White" BorderBrush="{StaticResource CcLine}"
                                BorderThickness="1.5" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource CcBlue}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EyeBtn" TargetType="ToggleButton">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="{StaticResource CcMuted}"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource CcBlue}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource CcBlue}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="54"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.78"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="290"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ LEFT PANEL ============ -->
        <Grid Grid.Column="0">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#EEF5FF" Offset="0"/>
                    <GradientStop Color="#D6E6FC" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>

            <StackPanel VerticalAlignment="Top" Margin="34,70,24,0">
                <TextBlock Text="🎓" FontSize="84" Foreground="{StaticResource CcNavy}"
                           HorizontalAlignment="Left" Margin="0,0,0,6"/>
                <TextBlock FontSize="31" FontWeight="Bold">
                    <Run Text="Campus" Foreground="{StaticResource CcNavy}"/><Run Text="Connect" Foreground="{StaticResource CcBlue}"/>
                </TextBlock>
                <TextBlock Text="Campus Event &amp; Ticketing System" FontSize="13"
                           Foreground="{StaticResource CcMuted}" Margin="0,4,0,0"/>

                <Rectangle Width="80" Height="2" Fill="{StaticResource CcBlue}"
                           HorizontalAlignment="Left" Margin="0,34,0,28"/>

                <TextBlock FontSize="19" FontWeight="Bold" Foreground="{StaticResource CcNavy}"
                           TextWrapping="Wrap" LineHeight="30">
                    Join the community.<LineBreak/>Be part of the events.
                </TextBlock>
                <TextBlock Text="Create your account to access campus events, buy tickets, and stay connected."
                           FontSize="14" Foreground="{StaticResource CcMuted}"
                           TextWrapping="Wrap" LineHeight="24" Margin="0,22,0,0"/>
            </StackPanel>

            <!-- simple school illustration -->
            <Canvas Width="290" Height="230" VerticalAlignment="Bottom" HorizontalAlignment="Left"
                    ClipToBounds="True">
                <!-- building -->
                <Rectangle Canvas.Left="38" Canvas.Top="96" Width="70" Height="80" Fill="#A9CBF4"/>
                <Rectangle Canvas.Left="182" Canvas.Top="96" Width="70" Height="80" Fill="#A9CBF4"/>
                <Rectangle Canvas.Left="100" Canvas.Top="66" Width="90" Height="110" Fill="#8FB9EF"/>
                <Polygon Points="92,68 145,36 198,68" Fill="#5B97E6"/>
                <Line X1="145" Y1="36" X2="145" Y2="12" Stroke="#3C6FC8" StrokeThickness="2"/>
                <Polygon Points="145,12 165,18 145,24" Fill="#4C8BE0"/>
                <Ellipse Canvas.Left="133" Canvas.Top="76" Width="24" Height="24" Fill="White"
                         Stroke="#3C7DDB" StrokeThickness="2"/>
                <!-- windows -->
                <Rectangle Canvas.Left="48" Canvas.Top="110" Width="12" Height="16" Fill="#EAF3FF"/>
                <Rectangle Canvas.Left="72" Canvas.Top="110" Width="12" Height="16" Fill="#EAF3FF"/>
                <Rectangle Canvas.Left="206" Canvas.Top="110" Width="12" Height="16" Fill="#EAF3FF"/>
                <Rectangle Canvas.Left="230" Canvas.Top="110" Width="12" Height="16" Fill="#EAF3FF"/>
                <Rectangle Canvas.Left="112" Canvas.Top="112" Width="12" Height="16" Fill="#EAF3FF"/>
                <Rectangle Canvas.Left="138" Canvas.Top="112" Width="12" Height="16" Fill="#EAF3FF"/>
                <Rectangle Canvas.Left="164" Canvas.Top="112" Width="12" Height="16" Fill="#EAF3FF"/>
                <Rectangle Canvas.Left="136" Canvas.Top="144" Width="18" Height="32" Fill="#2B5BB5"/>
                <!-- trees -->
                <Ellipse Canvas.Left="10" Canvas.Top="108" Width="38" Height="64" Fill="#2E5FB0"/>
                <Ellipse Canvas.Left="250" Canvas.Top="116" Width="34" Height="56" Fill="#3A6FC4"/>
                <!-- hill -->
                <Ellipse Canvas.Left="-90" Canvas.Top="165" Width="470" Height="320">
                    <Ellipse.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#78AEEF" Offset="0"/>
                            <GradientStop Color="#2F6FD6" Offset="1"/>
                        </LinearGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
            </Canvas>
        </Grid>

        <!-- ============ RIGHT PANEL ============ -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Background="White">
            <StackPanel Margin="46,38,46,26">

                <TextBlock Text="Create Account" FontSize="40" FontWeight="Bold"
                           Foreground="{StaticResource CcNavy}"/>
                <TextBlock Text="Fill in your details to get started" FontSize="17"
                           Foreground="{StaticResource CcMuted}" Margin="0,6,0,26"/>

                <!-- Full name -->
                <StackPanel Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                        <TextBlock Text="👤" FontSize="18" Foreground="{StaticResource CcNavy}" Margin="0,0,10,0"/>
                        <TextBlock Text="Full Name" Style="{StaticResource Label}"/>
                    </StackPanel>
                    <Grid>
                        <TextBox x:Name="FullNameBox" Style="{StaticResource FieldText}" TextChanged="Field_Changed"/>
                        <TextBlock x:Name="FullNameHint" Text="Enter your full name" Style="{StaticResource HintText}"/>
                    </Grid>
                </StackPanel>

                <!-- Username / school ID -->
                <StackPanel Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                        <TextBlock Text="🪪" FontSize="18" Foreground="{StaticResource CcNavy}" Margin="0,0,10,0"/>
                        <TextBlock Text="Username or School ID" Style="{StaticResource Label}"/>
                    </StackPanel>
                    <Grid>
                        <TextBox x:Name="UserBox" Style="{StaticResource FieldText}" TextChanged="Field_Changed"/>
                        <TextBlock x:Name="UserHint" Text="Enter your username or school ID" Style="{StaticResource HintText}"/>
                    </Grid>
                </StackPanel>

                <!-- Email -->
                <StackPanel Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                        <TextBlock Text="✉" FontSize="18" Foreground="{StaticResource CcNavy}" Margin="0,0,10,0"/>
                        <TextBlock Text="Email Address" Style="{StaticResource Label}"/>
                    </StackPanel>
                    <Grid>
                        <TextBox x:Name="EmailBox" Style="{StaticResource FieldText}" TextChanged="Field_Changed"/>
                        <TextBlock x:Name="EmailHint" Text="you@example.com" Style="{StaticResource HintText}"/>
                    </Grid>
                </StackPanel>

                <!-- Password -->
                <StackPanel Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                        <TextBlock Text="🔒" FontSize="18" Foreground="{StaticResource CcNavy}" Margin="0,0,10,0"/>
                        <TextBlock Text="Password" Style="{StaticResource Label}"/>
                    </StackPanel>
                    <Grid>
                        <PasswordBox x:Name="PwdBox" Style="{StaticResource FieldPassword}" PasswordChanged="Pwd_Changed"/>
                        <TextBox x:Name="PwdText" Style="{StaticResource FieldTextPwd}" Visibility="Collapsed"
                                 TextChanged="Field_Changed"/>
                        <TextBlock x:Name="PwdHint" Text="Create a password" Style="{StaticResource HintText}"/>
                        <ToggleButton x:Name="PwdToggle" Content="👁" Style="{StaticResource EyeBtn}"
                                      ToolTip="Show / hide password" Click="Eye_Click"/>
                    </Grid>
                </StackPanel>

                <!-- Confirm password -->
                <StackPanel Margin="0,0,0,24">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                        <TextBlock Text="🔒" FontSize="18" Foreground="{StaticResource CcNavy}" Margin="0,0,10,0"/>
                        <TextBlock Text="Confirm Password" Style="{StaticResource Label}"/>
                    </StackPanel>
                    <Grid>
                        <PasswordBox x:Name="ConfirmBox" Style="{StaticResource FieldPassword}" PasswordChanged="Pwd_Changed"/>
                        <TextBox x:Name="ConfirmText" Style="{StaticResource FieldTextPwd}" Visibility="Collapsed"
                                 TextChanged="Field_Changed"/>
                        <TextBlock x:Name="ConfirmHint" Text="Re-enter your password" Style="{StaticResource HintText}"/>
                        <ToggleButton x:Name="ConfirmToggle" Content="👁" Style="{StaticResource EyeBtn}"
                                      ToolTip="Show / hide password" Click="Eye_Click"/>
                    </Grid>
                </StackPanel>

                <Button Content="Create Account" Style="{StaticResource PrimaryBtn}"
                        IsDefault="True" Click="Create_Click"/>

                <TextBlock HorizontalAlignment="Center" Margin="0,20,0,0" FontSize="14"
                           Foreground="{StaticResource CcNavy}">
                    <Run Text="Already have an account?  "/><Hyperlink Click="BackToLogin_Click" Foreground="{StaticResource CcLink}"><Run Text="Back to Login" FontWeight="SemiBold"/></Hyperlink>
                </TextBlock>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>