<Window x:Class="CampusEventTicketing.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Campus Event &amp; Ticketing - Login"
        Width="900" Height="570"
        WindowStartupLocation="CenterScreen"
        Background="#F5F9FF">
    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Background="#0B2B5B">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="🎓" FontSize="76" HorizontalAlignment="Center"/>
                <TextBlock Text="CAMPUS EVENTS" Foreground="White" FontSize="28"
                           FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,5"/>
                <TextBlock Text="Connect • Attend • Make Memories"
                           Foreground="#DCEBFF" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Column="1" Margin="55">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="CAMPUS EVENT &amp; TICKETING"
                           Foreground="{StaticResource TextBrush}" FontSize="24"
                           FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="Welcome Back!" Foreground="{StaticResource TextBrush}"
                           FontSize="22" HorizontalAlignment="Center" Margin="0,14,0,28"/>

                <TextBlock Text="Username" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"/>
                <TextBox x:Name="UsernameBox" Height="44" Margin="0,7,0,18"/>

                <TextBlock Text="Password" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"/>
                <PasswordBox x:Name="PasswordBox" Height="44" Margin="0,7,0,18"/>

                <TextBlock Text="Login as" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,22">
                    <RadioButton x:Name="StudentRadio" Content="Student / User" IsChecked="True" Margin="0,0,25,0"/>
                    <RadioButton x:Name="AdminRadio" Content="Admin"/>
                </StackPanel>

                <Button Content="LOGIN" Height="46"
                        Background="{StaticResource BlueBrush}" Foreground="White"
                        FontWeight="Bold" Click="Login_Click"/>

                <Button Content="FORGET PASSWORD" Height="46" Margin="0,10,0,0"
                        Background="LightGreen" Foreground="Black"
                        FontWeight="Bold" Click="Forget_Click"/>
            </StackPanel>
        </Grid>

        <!-- Floating, draggable chatbot button (drag logic is in MainWindow.xaml.cs).
             A click without dragging still calls ChatButton_Click. -->
        <Button x:Name="ChatFab"
                Grid.Column="0" Grid.ColumnSpan="2"
                Style="{StaticResource CircleButton}"
                Width="64" Height="64"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,24,24"
                FontSize="30"
                Content="🤖"
                Cursor="SizeAll"
                ToolTip="Open CampusBot (drag to move)"
                PreviewMouseLeftButtonDown="ChatFab_MouseDown"
                PreviewMouseMove="ChatFab_MouseMove"
                PreviewMouseLeftButtonUp="ChatFab_MouseUp">
            <Button.RenderTransform>
                <TranslateTransform/>
            </Button.RenderTransform>
        </Button>
    </Grid>
</Window>