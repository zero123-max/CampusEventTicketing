<Window x:Class="CampusEventTicketing.AdminDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Campus Event &amp; Ticketing - Admin"
        Width="1200" Height="720"
        WindowStartupLocation="CenterScreen"
        Background="#F5F9FF">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Background="#0B2B5B">
            <StackPanel>
                <TextBlock Text="🎓" FontSize="48" HorizontalAlignment="Center" Margin="0,25,0,5"/>
                <TextBlock Text="ADMIN" Foreground="White" FontSize="24" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,0,0,35"/>
                <Button Content="Dashboard" Margin="15,5" Height="45" Click="Dashboard_Click"/>
                <Button Content="Manage Events" Margin="15,5" Height="45" Click="Events_Click"/>
                <Button Content="Students" Margin="15,5" Height="45" Click="Students_Click"/>
                <Button Content="Tickets" Margin="15,5" Height="45" Click="Tickets_Click"/>
                <Button Content="Reports" Margin="15,5" Height="45" Click="Reports_Click"/>
                <Button Content="Logout" Margin="15,50,15,5" Height="45" Click="Logout_Click"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Column="1" Margin="35">
            <StackPanel>
                <TextBlock Text="Admin Dashboard" FontSize="30" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                <TextBlock Text="Manage the campus event and ticketing system" Foreground="Gray" Margin="0,5,0,30"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="20" Margin="5">
                        <StackPanel><TextBlock Text="Events" Foreground="Gray"/><TextBlock Text="12" FontSize="30" FontWeight="Bold" Foreground="{StaticResource BlueBrush}"/></StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="20" Margin="5">
                        <StackPanel><TextBlock Text="Students" Foreground="Gray"/><TextBlock Text="350" FontSize="30" FontWeight="Bold" Foreground="{StaticResource BlueBrush}"/></StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="20" Margin="5">
                        <StackPanel><TextBlock Text="Tickets" Foreground="Gray"/><TextBlock Text="428" FontSize="30" FontWeight="Bold" Foreground="{StaticResource BlueBrush}"/></StackPanel>
                    </Border>
                    <Border Grid.Column="3" Background="White" CornerRadius="12" Padding="20" Margin="5">
                        <StackPanel><TextBlock Text="Upcoming" Foreground="Gray"/><TextBlock Text="5" FontSize="30" FontWeight="Bold" Foreground="{StaticResource BlueBrush}"/></StackPanel>
                    </Border>
                </Grid>

                <Border Background="White" CornerRadius="12" Padding="25" Margin="5,30,5,0">
                    <StackPanel>
                        <TextBlock Text="Event Management" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,20"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Add Event" Width="130" Height="45" Background="{StaticResource BlueBrush}" Foreground="White" Margin="0,0,10,0" Click="AddEvent_Click"/>
                            <Button Content="Edit Event" Width="130" Height="45" Margin="0,0,10,0" Click="EditEvent_Click"/>
                            <Button Content="Delete Event" Width="130" Height="45" Click="DeleteEvent_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Button Width="68" Height="68" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Background="{StaticResource BlueBrush}" Foreground="White" FontSize="30"
                    Content="🤖" Click="ChatButton_Click"/>
        </Grid>
    </Grid>
</Window>
