<Window x:Class="CampusEventTicketing.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Campus Event &amp; Ticketing - Student"
        Width="1280" Height="780" MinWidth="1050" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="#F5F9FF">

    <Window.Resources>

        <!-- ================= STYLES ================= -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Margin" Value="15,3"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="20,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource BlueBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource BlueBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BlueBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OutlineButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource BlueBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="White" BorderBrush="{StaticResource BlueBrush}"
                                BorderThickness="1.5" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EAF3FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabButton" TargetType="Button">
            <Setter Property="Foreground" Value="#4A6390"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="22,10"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" BorderBrush="Transparent" BorderThickness="0,0,0,3"
                                Padding="{TemplateBinding Padding}" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BlueBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource BlueBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RowButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                                CornerRadius="8" Padding="14,12" Margin="0,0,0,8">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F5F9FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6">
                            <Grid>
                                <TextBlock x:Name="hint" Text="{TemplateBinding Tag}" Foreground="#94A3B8"
                                           Margin="34,0,0,0" VerticalAlignment="Center"
                                           IsHitTestVisible="False" Visibility="Collapsed"/>
                                <TextBlock Text="🔍" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#64748B"/>
                                <ScrollViewer x:Name="PART_ContentHost" Margin="32,0,8,0" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="hint" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PwdBox" TargetType="PasswordBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Margin" Value="0,5,0,14"/>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D7E4F5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <Style x:Key="HistHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F0F5FC"/>
            <Setter Property="Foreground" Value="#4A6390"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style x:Key="HistCell" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="12,0" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================= EVENT CARD ================= -->
        <DataTemplate x:Key="EventCard">
            <Border Width="236" Style="{StaticResource Card}" Padding="10" Margin="0,0,16,16">
                <StackPanel>
                    <Border Background="{Binding BannerBrush}" CornerRadius="8" Height="110">
                        <Grid>
                            <TextBlock Text="{Binding Banner}" FontSize="52"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border Background="{Binding CategoryBrush}" CornerRadius="4" Padding="9,2"
                                    HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8">
                                <TextBlock Text="{Binding Category}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}" Margin="2,10,0,4" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding DateText, StringFormat='📅  {0}'}" Foreground="#4A6390" FontSize="12" Margin="2,0,0,0"/>
                    <TextBlock Text="{Binding Location, StringFormat='📍  {0}'}" Foreground="#4A6390" FontSize="12" Margin="2,3,0,0"/>
                    <TextBlock Text="{Binding Price}" Foreground="{Binding PriceBrush}" FontSize="12"
                               FontWeight="Bold" Margin="2,6,0,8"/>
                    <Button Style="{StaticResource PrimaryButton}" Content="View Details" Click="ViewDetails_Click"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- ================= TICKET CARD ================= -->
        <DataTemplate x:Key="TicketCard">
            <Border Width="420" Style="{StaticResource Card}" Padding="12" Margin="0,0,16,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{Binding BannerBrush}" CornerRadius="8" Height="84" VerticalAlignment="Top">
                        <TextBlock Text="{Binding Banner}" FontSize="42" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="12,0,8,0">
                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding DateTimeText, StringFormat='📅  {0}'}" Foreground="#4A6390" FontSize="11.5" Margin="0,6,0,0"/>
                        <TextBlock Text="{Binding Location, StringFormat='📍  {0}'}" Foreground="#4A6390" FontSize="11.5" Margin="0,3,0,0"/>
                        <TextBlock Text="{Binding TicketId, StringFormat='Ticket ID: {0}'}" Foreground="#4A6390" FontSize="11.5" Margin="0,8,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Width="96">
                        <Border Background="{Binding StatusBack}" CornerRadius="9" Padding="8,1" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding Status}" Foreground="{Binding StatusFore}" FontSize="10.5" FontWeight="SemiBold"/>
                        </Border>
                        <TextBlock Text="{Binding TicketType}" FontSize="10.5" Foreground="#4A6390"
                                   HorizontalAlignment="Center" Margin="0,6,0,3"/>
                        <Border Background="White" BorderBrush="#D7E4F5" BorderThickness="1" CornerRadius="4"
                                Width="60" Height="60">
                            <TextBlock Text="▦" FontSize="46" Foreground="#0B2B5B"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Button Style="{StaticResource PrimaryButton}" Content="View Ticket" Height="26"
                                Margin="0,6,0,0" Click="ViewTicket_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="245"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= SIDEBAR ================= -->
        <Grid Grid.Column="0" Background="#0B2B5B">
            <DockPanel>
                <Button DockPanel.Dock="Bottom" Style="{StaticResource NavButton}"
                        Content="🚪   Logout" Margin="15,3,15,22" Click="Logout_Click"/>

                <Button DockPanel.Dock="Bottom" Style="{StaticResource NavButton}" Click="CampusBot_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🤖   CampusBot" VerticalAlignment="Center"/>
                        <Border Background="{StaticResource BlueBrush}" CornerRadius="9" Padding="8,1" Margin="10,0,0,0">
                            <TextBlock Text="New" FontSize="10.5" FontWeight="SemiBold" Foreground="White"/>
                        </Border>
                    </StackPanel>
                </Button>

                <StackPanel>
                    <TextBlock Text="🎓" FontSize="46" HorizontalAlignment="Center" Margin="0,28,0,4"/>
                    <TextBlock Text="CAMPUS EVENTS" Foreground="White" FontSize="19" FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Connect • Attend • Make Memories" Foreground="#DCEBFF" FontSize="10.5"
                               HorizontalAlignment="Center" Margin="0,2,0,28"/>

                    <Button x:Name="BtnDash"     Style="{StaticResource NavButton}" Content="🏠   Dashboard"  Tag="Active" Click="Dashboard_Click"/>
                    <Button x:Name="BtnEvents"   Style="{StaticResource NavButton}" Content="📅   Events"     Click="Events_Click"/>
                    <Button x:Name="BtnTickets"  Style="{StaticResource NavButton}" Content="🎟   My Tickets" Click="Tickets_Click"/>
                    <Button x:Name="BtnHistory"  Style="{StaticResource NavButton}" Content="📋   History"    Click="History_Click"/>
                    <Button x:Name="BtnSettings" Style="{StaticResource NavButton}" Content="⚙   Settings"   Click="Settings_Click"/>
                </StackPanel>
            </DockPanel>
        </Grid>

        <!-- ================= CONTENT ================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" HorizontalAlignment="Right" Margin="0,16,32,0" Background="White"
                    BorderBrush="#D7E4F5" BorderThickness="1" CornerRadius="18" Padding="14,6">
                <TextBlock Text="👤  Student  ▾" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <Grid Margin="35,6,35,30">

                    <!-- ============ DASHBOARD ============ -->
                    <StackPanel x:Name="PageDash">
                        <TextBlock Text="Welcome to Campus Events!" FontSize="32" FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="Discover, join, and be part of the campus experience."
                                   Foreground="#4A6390" FontSize="15" Margin="0,4,0,24"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#EAF3FF" BorderBrush="#D7E4F5" BorderThickness="1"
                                    CornerRadius="14" Padding="22" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="📅" FontSize="26"/>
                                    <TextBlock Text="EVENTS" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,10,0,0"/>
                                    <TextBlock x:Name="StatEvents" Text="0" FontSize="36" FontWeight="Bold" Foreground="{StaticResource BlueBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="#E9F8F0" BorderBrush="#CDEBDA" BorderThickness="1"
                                    CornerRadius="14" Padding="22" Margin="5,0,5,0">
                                <StackPanel>
                                    <TextBlock Text="🎟" FontSize="26"/>
                                    <TextBlock Text="MY TICKETS" FontWeight="Bold" Foreground="#1B6B45" Margin="0,10,0,0"/>
                                    <TextBlock x:Name="StatTickets" Text="0" FontSize="36" FontWeight="Bold" Foreground="#1E9E62"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="#F1EAFB" BorderBrush="#E0D2F5" BorderThickness="1"
                                    CornerRadius="14" Padding="22" Margin="10,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="👥" FontSize="26"/>
                                    <TextBlock Text="UPCOMING" FontWeight="Bold" Foreground="#4B2A8F" Margin="0,10,0,0"/>
                                    <TextBlock x:Name="StatUpcoming" Text="0" FontSize="36" FontWeight="Bold" Foreground="#7A3FD1"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Margin="0,28,0,14">
                            <TextBlock Text="UPCOMING CAMPUS EVENTS" FontSize="22" FontWeight="Bold"
                                       Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                            <Button Style="{StaticResource LinkButton}" Content="View All  →"
                                    HorizontalAlignment="Right" Click="ViewAll_Click"/>
                        </Grid>

                        <ItemsControl x:Name="DashCards" ItemTemplate="{StaticResource EventCard}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>

                    <!-- ============ EVENTS ============ -->
                    <StackPanel x:Name="PageEvents" Visibility="Collapsed">
                        <Grid Margin="0,0,0,20">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📅" FontSize="34" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <StackPanel>
                                    <TextBlock Text="Events" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                                    <TextBlock Text="Explore and join upcoming campus events." Foreground="#4A6390"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                <TextBox x:Name="EventSearch" Style="{StaticResource SearchBox}" Tag="Search events..."
                                         Width="220" Margin="0,0,10,0" TextChanged="EventFilter_Changed"/>
                                <ComboBox x:Name="EventCategory" Width="150" Height="38" VerticalContentAlignment="Center"
                                          SelectionChanged="EventFilter_Changed">
                                    <ComboBoxItem Content="All Categories" IsSelected="True"/>
                                    <ComboBoxItem Content="Sports"/>
                                    <ComboBoxItem Content="Tech"/>
                                    <ComboBoxItem Content="Music"/>
                                    <ComboBoxItem Content="Arts"/>
                                    <ComboBoxItem Content="Food"/>
                                    <ComboBoxItem Content="Wellness"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <ItemsControl x:Name="EventCards" ItemTemplate="{StaticResource EventCard}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <TextBlock x:Name="EventsEmpty" Text="No events match your search." Foreground="#4A6390"
                                   FontSize="14" Margin="4,10,0,0" Visibility="Collapsed"/>
                    </StackPanel>

                    <!-- ============ MY TICKETS ============ -->
                    <StackPanel x:Name="PageTickets" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                            <TextBlock Text="🎟" FontSize="34" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <StackPanel>
                                <TextBlock Text="My Tickets" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                                <TextBlock Text="Your purchased tickets and event passes." Foreground="#4A6390"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Style="{StaticResource Card}" Padding="20,10,20,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,14">
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="TabUpcoming" Style="{StaticResource TabButton}" Content="Upcoming Tickets"
                                                Tag="Active" Click="TabUpcoming_Click"/>
                                        <Button x:Name="TabPast" Style="{StaticResource TabButton}" Content="Past Tickets"
                                                Click="TabPast_Click"/>
                                    </StackPanel>
                                    <TextBox x:Name="TicketSearch" Style="{StaticResource SearchBox}" Tag="Search tickets..."
                                             Width="240" HorizontalAlignment="Right" TextChanged="TicketSearch_Changed"/>
                                </Grid>

                                <ItemsControl x:Name="TicketCards" ItemTemplate="{StaticResource TicketCard}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <TextBlock x:Name="TicketsEmpty" Text="No tickets found." Foreground="#4A6390"
                                           FontSize="14" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ============ HISTORY ============ -->
                    <StackPanel x:Name="PageHistory" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                            <TextBlock Text="🕘" FontSize="34" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <StackPanel>
                                <TextBlock Text="Purchase History" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                                <TextBlock Text="View your past event purchases and ticket details." Foreground="#4A6390"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Style="{StaticResource Card}" Padding="16">
                            <StackPanel>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="HistoryEventBox" Grid.Column="0" Height="38" Margin="0,0,10,0"
                                              VerticalContentAlignment="Center" SelectionChanged="HistoryFilter_Changed"/>
                                    <TextBox x:Name="HistorySearch" Grid.Column="1" Style="{StaticResource SearchBox}"
                                             Tag="Search history..." TextChanged="HistoryFilter_Changed"/>
                                </Grid>

                                <DataGrid x:Name="HistoryGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                          CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="#E6ECF5" Background="White" BorderThickness="0"
                                          RowHeight="54" FontSize="13" SelectionMode="Single" ColumnWidth="*"
                                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                          CellStyle="{StaticResource HistCell}"
                                          ColumnHeaderStyle="{StaticResource HistHeader}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Event" Binding="{Binding EventName}" Width="2*"/>
                                        <DataGridTextColumn Header="Date of Purchase" Binding="{Binding PurchaseDate}" Width="1.6*"/>
                                        <DataGridTextColumn Header="Ticket Type" Binding="{Binding TicketType}" Width="1.4*"/>
                                        <DataGridTextColumn Header="Amount" Binding="{Binding Amount}" Width="*"/>
                                        <DataGridTemplateColumn Header="Status" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Background="#D1FAE5" BorderBrush="#34D399" BorderThickness="1"
                                                            CornerRadius="10" Padding="10,2" HorizontalAlignment="Left">
                                                        <TextBlock Text="{Binding Status}" Foreground="#15803D" FontSize="11" FontWeight="SemiBold"/>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Actions" Width="130">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="View Details" Style="{StaticResource OutlineButton}"
                                                            Click="ViewPurchase_Click"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <TextBlock x:Name="HistoryCount" Foreground="#4A6390" FontSize="12" Margin="2,12,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ============ SETTINGS ============ -->
                    <StackPanel x:Name="PageSettings" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                            <TextBlock Text="⚙" FontSize="34" Margin="0,0,12,0" VerticalAlignment="Center"
                                       Foreground="{StaticResource BlueBrush}"/>
                            <StackPanel>
                                <TextBlock Text="Settings" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                                <TextBlock Text="Manage your account information and security." Foreground="#4A6390"/>
                            </StackPanel>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- left column -->
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="👤  Profile Information" FontSize="16" FontWeight="Bold"
                                                   Foreground="{StaticResource TextBrush}" Margin="0,0,0,16"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="92" Height="92" CornerRadius="46" Background="#DBEAFE" Margin="0,0,20,0">
                                                <TextBlock Text="👤" FontSize="46" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Student" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                                                <TextBlock Text="student@campus.edu" Foreground="#4A6390" Margin="0,3,0,12"/>
                                                <Button Content="Edit Profile" Style="{StaticResource PrimaryButton}"
                                                        Width="150" HorizontalAlignment="Left" Click="EditProfile_Click"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Account Information" FontSize="16" FontWeight="Bold"
                                                   Foreground="{StaticResource TextBrush}" Margin="0,0,0,10"/>
                                        <Grid Margin="0,6">
                                            <TextBlock Text="Role" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                            <TextBlock Text="Student / User" HorizontalAlignment="Right" Foreground="#4A6390"/>
                                        </Grid>
                                        <Separator Background="#E6ECF5"/>
                                        <Grid Margin="0,6">
                                            <TextBlock Text="Username" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                            <TextBlock Text="student" HorizontalAlignment="Right" Foreground="#4A6390"/>
                                        </Grid>
                                        <Separator Background="#E6ECF5"/>
                                        <Grid Margin="0,6">
                                            <TextBlock Text="Email" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                            <TextBlock Text="student@campus.edu" HorizontalAlignment="Right" Foreground="#4A6390"/>
                                        </Grid>
                                        <Separator Background="#E6ECF5"/>
                                        <Grid Margin="0,6">
                                            <TextBlock Text="Member Since" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                            <TextBlock Text="August 1, 2026" HorizontalAlignment="Right" Foreground="#4A6390"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- right column -->
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="🔒  Change Password" FontSize="16" FontWeight="Bold"
                                                   Foreground="{StaticResource TextBrush}" Margin="0,0,0,12"/>
                                        <TextBlock Text="Current Password" Foreground="#4A6390" FontSize="12"/>
                                        <PasswordBox x:Name="PwdCurrent" Style="{StaticResource PwdBox}"/>
                                        <TextBlock Text="New Password" Foreground="#4A6390" FontSize="12"/>
                                        <PasswordBox x:Name="PwdNew" Style="{StaticResource PwdBox}"/>
                                        <TextBlock Text="Confirm New Password" Foreground="#4A6390" FontSize="12"/>
                                        <PasswordBox x:Name="PwdConfirm" Style="{StaticResource PwdBox}"/>
                                        <Button Content="Update Password" Style="{StaticResource PrimaryButton}"
                                                Height="40" FontSize="13" Click="UpdatePassword_Click"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Account Actions" FontSize="16" FontWeight="Bold"
                                                   Foreground="{StaticResource TextBrush}" Margin="0,0,0,12"/>

                                        <Button Style="{StaticResource RowButton}" Click="Logout_Click">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="↪" FontSize="22" Foreground="#EF4444" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="Logout" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                                    <TextBlock Text="Sign out from your account" FontSize="11.5" Foreground="#64748B"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="›" FontSize="22" Foreground="#64748B" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Button>

                                        <Button Style="{StaticResource RowButton}" Click="DeleteAccount_Click">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="🗑" FontSize="20" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="Delete Account" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                                    <TextBlock Text="Permanently delete your account" FontSize="11.5" Foreground="#64748B"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="›" FontSize="22" Foreground="#64748B" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>