<Window x:Class="CampusEventTicketing.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Campus Event &amp; Ticketing - Student"
        Width="1200" Height="720"
        WindowStartupLocation="CenterScreen"
        Background="#F5F9FF">

    <Window.Resources>
        <!-- Flat sidebar button -->
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="Margin" Value="15,4"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="20,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Text-only "View All" link button -->
        <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="{StaticResource BlueBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Blue "View Details" button -->
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource BlueBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Margin" Value="0,14,0,0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= Sidebar ================= -->
        <Grid Grid.Column="0" Background="#0B2B5B">
            <StackPanel>
                <TextBlock Text="🎓" FontSize="48" HorizontalAlignment="Center" Margin="0,30,0,4"/>
                <TextBlock Text="CAMPUS EVENTS" Foreground="White" FontSize="20" FontWeight="Bold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Connect • Attend • Make Memories" Foreground="#DCEBFF" FontSize="11"
                           HorizontalAlignment="Center" Margin="0,2,0,30"/>

                <Button Style="{StaticResource NavButton}" Content="🏠   Dashboard"
                        Background="{StaticResource BlueBrush}" Click="Dashboard_Click"/>
                <Button Style="{StaticResource NavButton}" Content="📅   Events"    Click="Events_Click"/>
                <Button Style="{StaticResource NavButton}" Content="🎟   My Tickets" Click="Tickets_Click"/>
                <Button Style="{StaticResource NavButton}" Content="📋   History"    Click="History_Click"/>
                <Button Style="{StaticResource NavButton}" Content="⚙   Settings"   Click="Settings_Click"/>
                <Button Style="{StaticResource NavButton}" Content="🚪   Logout"
                        Margin="15,30,15,4" Click="Logout_Click"/>
            </StackPanel>
        </Grid>

        <!-- ================= Main content ================= -->
        <Grid Grid.Column="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="35,35,35,30">

                    <TextBlock Text="Welcome to Campus Events!" FontSize="34" FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="Discover, join, and be part of the campus experience."
                               Foreground="#4A6390" FontSize="16" Margin="0,4,0,28"/>

                    <!-- Stat cards -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#EAF3FF" BorderBrush="#D7E4F5" BorderThickness="1"
                                CornerRadius="14" Padding="22" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="📅" FontSize="26"/>
                                <TextBlock Text="EVENTS" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,12,0,0"/>
                                <TextBlock Text="12" FontSize="38" FontWeight="Bold" Foreground="{StaticResource BlueBrush}"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="#E9F8F0" BorderBrush="#CDEBDA" BorderThickness="1"
                                CornerRadius="14" Padding="22" Margin="5,0,5,0">
                            <StackPanel>
                                <TextBlock Text="🎟" FontSize="26"/>
                                <TextBlock Text="MY TICKETS" FontWeight="Bold" Foreground="#1B6B45" Margin="0,12,0,0"/>
                                <TextBlock Text="3" FontSize="38" FontWeight="Bold" Foreground="#1E9E62"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="#F1EAFB" BorderBrush="#E0D2F5" BorderThickness="1"
                                CornerRadius="14" Padding="22" Margin="10,0,0,0">
                            <StackPanel>
                                <TextBlock Text="👥" FontSize="26"/>
                                <TextBlock Text="UPCOMING" FontWeight="Bold" Foreground="#4B2A8F" Margin="0,12,0,0"/>
                                <TextBlock Text="5" FontSize="38" FontWeight="Bold" Foreground="#7A3FD1"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Section header -->
                    <Grid Margin="0,32,0,14">
                        <TextBlock Text="UPCOMING CAMPUS EVENTS" FontSize="24" FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource LinkButton}" Content="View All  →"
                                HorizontalAlignment="Right" Click="ViewAll_Click"/>
                    </Grid>

                    <!-- Event cards -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="White" BorderBrush="#D7E4F5" BorderThickness="1"
                                CornerRadius="14" Padding="14" Margin="0,0,10,0">
                            <StackPanel>
                                <Border Background="#74B6F2" CornerRadius="10" Height="130">
                                    <TextBlock Text="⚽" FontSize="64" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Campus Sports Festival" FontSize="17" FontWeight="Bold"
                                           Foreground="{StaticResource TextBrush}" Margin="0,12,0,6"/>
                                <TextBlock Text="📅  September 25, 2026" Foreground="#4A6390"/>
                                <TextBlock Text="📍  University Gym" Foreground="#4A6390" Margin="0,4,0,0"/>
                                <Button Style="{StaticResource PrimaryButton}" Content="VIEW DETAILS"
                                        Tag="Campus Sports Festival" Click="ViewDetails_Click"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="White" BorderBrush="#D7E4F5" BorderThickness="1"
                                CornerRadius="14" Padding="14" Margin="5,0,5,0">
                            <StackPanel>
                                <Border Background="#243F66" CornerRadius="10" Height="130">
                                    <TextBlock Text="💻" FontSize="64" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Student Tech Summit" FontSize="17" FontWeight="Bold"
                                           Foreground="{StaticResource TextBrush}" Margin="0,12,0,6"/>
                                <TextBlock Text="📅  October 5, 2026" Foreground="#4A6390"/>
                                <TextBlock Text="📍  ICT Building" Foreground="#4A6390" Margin="0,4,0,0"/>
                                <Button Style="{StaticResource PrimaryButton}" Content="VIEW DETAILS"
                                        Tag="Student Tech Summit" Click="ViewDetails_Click"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="White" BorderBrush="#D7E4F5" BorderThickness="1"
                                CornerRadius="14" Padding="14" Margin="10,0,0,0">
                            <StackPanel>
                                <Border Background="#6B2A9E" CornerRadius="10" Height="130">
                                    <TextBlock Text="🎵" FontSize="64" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Campus Music Night" FontSize="17" FontWeight="Bold"
                                           Foreground="{StaticResource TextBrush}" Margin="0,12,0,6"/>
                                <TextBlock Text="📅  October 15, 2026" Foreground="#4A6390"/>
                                <TextBlock Text="📍  University Auditorium" Foreground="#4A6390" Margin="0,4,0,0"/>
                                <Button Style="{StaticResource PrimaryButton}" Content="VIEW DETAILS"
                                        Tag="Campus Music Night" Click="ViewDetails_Click"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- Circular chatbot button (top-right, stays in place while scrolling) -->
            <Button Style="{StaticResource CircleButton}"
                    Width="64" Height="64"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,30,35,0"
                    FontSize="30" Content="🤖"
                    FocusVisualStyle="{x:Null}"
                    ToolTip="Open CampusBot"
                    Click="CampusBot_Click"/>
        </Grid>
    </Grid>
</Window>