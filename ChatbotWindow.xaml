<Window x:Class="CampusEventTicketing.ChatbotWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CampusBot"
        Width="390" Height="570"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F9FF">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="62"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="72"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#146EF5">
            <DockPanel Margin="18,0">
                <TextBlock Text="🤖"
                           FontSize="28"
                           VerticalAlignment="Center"/>
                <TextBlock Text="CampusBot"
                           Foreground="White"
                           FontSize="20"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"/>
                <TextBlock Text="AI Campus Assistant"
                           Foreground="#DCEBFF"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0"/>
            </DockPanel>
        </Border>

        <!-- Chat area -->
        <ScrollViewer Grid.Row="1" x:Name="ChatScroll" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ChatPanel" Margin="14">
                <Border Background="White"
                        BorderBrush="#D7E4F5"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="14"
                        Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Hello! I'm CampusBot 👋"
                                   FontWeight="Bold"
                                   Foreground="#102A62"
                                   FontSize="15"/>
                        <TextBlock Text="I can help with events, tickets, login problems, schedules, and campus information."
                                   TextWrapping="Wrap"
                                   Foreground="#34527E"
                                   Margin="0,7,0,0"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="Try asking me:"
                           FontWeight="SemiBold"
                           Foreground="#102A62"
                           Margin="3,0,0,8"/>

                <WrapPanel x:Name="Suggestions">
                    <Button Content="What events are coming up?"
                            Click="Suggestion_Click"
                            Background="#EAF3FF"
                            Foreground="#146EF5"
                            Padding="12,7"
                            Margin="3"/>
                    <Button Content="How do I reset my password?"
                            Click="Suggestion_Click"
                            Background="#EAF3FF"
                            Foreground="#146EF5"
                            Padding="12,7"
                            Margin="3"/>
                    <Button Content="Where can I get tickets?"
                            Click="Suggestion_Click"
                            Background="#EAF3FF"
                            Foreground="#146EF5"
                            Padding="12,7"
                            Margin="3"/>
                    <Button Content="I can't login"
                            Click="Suggestion_Click"
                            Background="#EAF3FF"
                            Foreground="#146EF5"
                            Padding="12,7"
                            Margin="3"/>
                </WrapPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Message box -->
        <Border Grid.Row="2" Background="White" BorderBrush="#D7E4F5" BorderThickness="1,1,0,0">
            <DockPanel Margin="10">
                <Button DockPanel.Dock="Right"
                        Width="48"
                        Background="#146EF5"
                        Foreground="White"
                        FontSize="22"
                        Content="➤"
                        Click="Send_Click"/>
                <TextBox x:Name="MessageBox"
                         Height="45"
                         VerticalContentAlignment="Center"
                         Text=""
                         KeyDown="MessageBox_KeyDown"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>